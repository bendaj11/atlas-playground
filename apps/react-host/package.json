{
  "name": "react-host",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "atlas dev react-host",
    "framework:dev": "vite --host 0.0.0.0",
    "atlas:config": "atlas compile-config react-host",
    "build": "tsc -b && vite build",
    "atlas:publish": "atlas publish react-host",
    "atlas:bootstrap": "atlas bootstrap react-host --skip-compile"
  },
  "dependencies": {
    "@atlas/schema": "^0.4.26",
    "@atlas/sdk": "^0.4.26",
    "@atlas/runtime": "^0.4.26",
    "es-module-shims": "^2.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "^7.9.0"
  },
  "devDependencies": {
    "@atlas/cli": "^0.4.26",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "~5.9.0",
    "vite": "^7.3.6"
  }
}
